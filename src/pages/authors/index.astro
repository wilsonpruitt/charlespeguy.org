---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

let authors: Awaited<ReturnType<typeof getCollection<'authors'>>> = [];
try {
  authors = await getCollection('authors');
  // Alphabetical by sortable surname per the site-direction decision
  authors.sort((a, b) =>
    (a.data.nameSort || a.data.name).localeCompare(b.data.nameSort || b.data.name)
  );
} catch {
  // Collection empty during initial scaffold
}
---

<Base title="Authors">
  <h1>Authors</h1>
  <p class="metadata">
    Every contributor to the Cahiers de la Quinzaine, alphabetical by surname.
    Click an author's name to see all the pieces they published in the cahiers,
    in publication order.
  </p>

  {authors.length === 0 && (
    <div class="placeholder">
      <p><em>Content migration in progress — the author index will appear here
      once contributor metadata has been imported.</em></p>
    </div>
  )}

  {authors.length > 0 && (
    <ul class="authors">
      {authors.map(author => (
        <li>
          <a href={`/authors/${author.data.slug}`}>{author.data.name}</a>
          {author.data.isEditor && <span class="role"> · editor</span>}
          {(author.data.born || author.data.died) && (
            <span class="dates">
              {' '}({author.data.born?.slice(0, 4) ?? '?'}–{author.data.died?.slice(0, 4) ?? '?'})
            </span>
          )}
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .placeholder {
    margin: 3rem auto;
    padding: 2rem;
    max-width: var(--measure);
    background: var(--paper-deep);
    border-left: 3px solid var(--rouge);
    color: var(--ink-soft);
    text-align: center;
  }

  .authors {
    list-style: none;
    padding: 0;
    columns: 2;
    column-gap: 3rem;
    margin: 2rem 0;
    max-width: var(--measure-wide);
  }

  .authors li {
    margin: 0.4rem 0;
    break-inside: avoid;
  }

  .role {
    color: var(--rouge);
    font-style: italic;
    font-size: 0.9rem;
  }

  .dates {
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
</style>
