---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  const cahiers = await getCollection('cahiers');
  cahiers.sort((a, b) => {
    if (a.data.series !== b.data.series) return a.data.series - b.data.series;
    return a.data.issue - b.data.issue;
  });

  // Pre-compute, per author, the list of {cahier, piece} they contributed to,
  // and (for Péguy) the list of Avertissements with their introduces-target.
  const pieces = await getCollection('pieces');
  const pieceLangs = new Map<string, { fr: boolean; en: boolean }>();
  for (const p of pieces) {
    const key = `${p.data.cahier.id}--${p.data.pieceSlug}`;
    const entry = pieceLangs.get(key) ?? { fr: false, en: false };
    entry[p.data.lang] = true;
    pieceLangs.set(key, entry);
  }

  return authors.map(author => {
    const contributions: Array<{
      cahier: typeof cahiers[number];
      piece: typeof cahiers[number]['data']['pieces'][number];
      langs: { fr: boolean; en: boolean };
    }> = [];
    for (const cahier of cahiers) {
      for (const p of cahier.data.pieces) {
        if (p.author.id === author.id) {
          const key = `${cahier.id}--${p.slug}`;
          contributions.push({ cahier, piece: p, langs: pieceLangs.get(key) ?? { fr: false, en: false } });
        }
      }
    }
    return {
      params: { slug: author.id },
      props: { author, contributions },
    };
  });
}

const { author, contributions } = Astro.props;
const d = author.data;
const { Content } = await render(author);

// For Péguy specifically, split contributions into Avertissements vs. his own writings.
const isPeguy = d.isEditor;
const avertissements = isPeguy ? contributions.filter(c => c.piece.isAvertissement) : [];
const writings = isPeguy ? contributions.filter(c => !c.piece.isAvertissement) : contributions;
---

<Base title={d.name} lang="en">
  <article class="author">
    <header class="author-head">
      <h1 class="author-name">{d.name}</h1>
      {(d.born || d.died) && (
        <p class="author-dates">
          {d.born ?? '?'} — {d.died ?? '?'}
        </p>
      )}
      {d.isEditor && (
        <p class="author-role">Editor, <em>Cahiers de la Quinzaine</em>, 1900–1914</p>
      )}
    </header>

    <section class="author-bio reading">
      <Content />
    </section>

    <div class="rule-ornament"></div>

    {isPeguy ? (
      <>
        <section class="author-list">
          <h2 class="list-head">Writings in the Cahiers</h2>
          <p class="list-meta">{writings.length} pieces in publication order.</p>
          <ol class="contrib-list">
            {writings.map(c => (
              <li>
                <p class="contrib-title">{c.piece.titleFr}</p>
                <p class="contrib-meta">
                  <a href={`/cahiers/${c.cahier.id}`} class="contrib-cahier">
                    <span class="contrib-label">{c.cahier.data.label}</span>
                    <span class="contrib-cahier-title"> · {c.cahier.data.titleFr}</span>
                  </a>
                  {c.cahier.data.bonATirer && <span class="contrib-date"> · {c.cahier.data.bonATirer}</span>}
                </p>
                <p class="contrib-read">
                  {c.langs.fr && <a href={`/cahiers/${c.cahier.id}/${c.piece.slug}/fr`}>French</a>}
                  {c.langs.fr && c.langs.en && <span class="sep"> · </span>}
                  {c.langs.en && <a href={`/cahiers/${c.cahier.id}/${c.piece.slug}/en`}>English</a>}
                </p>
              </li>
            ))}
          </ol>
        </section>

        {avertissements.length > 0 && (
          <section class="author-list ave-section">
            <h2 class="list-head">Avertissements</h2>
            <p class="list-meta">
              Péguy's editorial framings of other contributors' pieces — {avertissements.length} in all,
              each cross-linked to the article it introduced.
            </p>
            <ol class="contrib-list">
              {avertissements.map(c => {
                const intro = c.cahier.data.pieces.find(p => p.slug === (c.piece as any).introducesPiece);
                return (
                  <li>
                    <p class="contrib-title"><em>Avertissement</em></p>
                    <p class="contrib-meta">
                      <a href={`/cahiers/${c.cahier.id}`} class="contrib-cahier">
                        <span class="contrib-label">{c.cahier.data.label}</span>
                        <span class="contrib-cahier-title"> · {c.cahier.data.titleFr}</span>
                      </a>
                    </p>
                    {intro && (
                      <p class="contrib-introduces">
                        Introduces: <em>{intro.titleFr}</em>
                      </p>
                    )}
                    <p class="contrib-read">
                      {c.langs.fr && <a href={`/cahiers/${c.cahier.id}/${c.piece.slug}/fr`}>French</a>}
                      {c.langs.fr && c.langs.en && <span class="sep"> · </span>}
                      {c.langs.en && <a href={`/cahiers/${c.cahier.id}/${c.piece.slug}/en`}>English</a>}
                    </p>
                  </li>
                );
              })}
            </ol>
          </section>
        )}
      </>
    ) : (
      <section class="author-list">
        <h2 class="list-head">In the Cahiers</h2>
        <p class="list-meta">
          {contributions.length} {contributions.length === 1 ? 'piece' : 'pieces'} in publication order.
        </p>
        {contributions.length === 0 ? (
          <p class="empty">No pieces yet linked to this author.</p>
        ) : (
          <ol class="contrib-list">
            {contributions.map(c => (
              <li>
                <p class="contrib-title">{c.piece.titleFr}</p>
                <p class="contrib-meta">
                  <a href={`/cahiers/${c.cahier.id}`} class="contrib-cahier">
                    <span class="contrib-label">{c.cahier.data.label}</span>
                    <span class="contrib-cahier-title"> · {c.cahier.data.titleFr}</span>
                  </a>
                  {c.cahier.data.bonATirer && <span class="contrib-date"> · {c.cahier.data.bonATirer}</span>}
                </p>
                <p class="contrib-read">
                  {c.langs.fr && <a href={`/cahiers/${c.cahier.id}/${c.piece.slug}/fr`}>French</a>}
                  {c.langs.fr && c.langs.en && <span class="sep"> · </span>}
                  {c.langs.en && <a href={`/cahiers/${c.cahier.id}/${c.piece.slug}/en`}>English</a>}
                </p>
              </li>
            ))}
          </ol>
        )}
      </section>
    )}
  </article>
</Base>

<style>
  .author { max-width: var(--measure-wide); margin: 0 auto; }

  .author-head { text-align: center; margin: 1rem 0 2rem; }
  .author-name { font-size: 2.4rem; margin: 0; }
  .author-dates {
    font-style: italic; color: var(--rouge);
    letter-spacing: 0.2em; margin: 0.4rem 0 0;
    font-size: 0.95rem;
  }
  .author-role {
    margin: 0.4rem 0 0; color: var(--ink-soft);
    font-style: italic; font-size: 0.95rem;
  }

  .author-bio { margin: 2rem auto; }
  .author-bio :global(h2) {
    font-size: 1.1rem; font-variant: small-caps;
    letter-spacing: 0.1em; color: var(--ink-muted);
    text-align: center; font-weight: 400; margin: 2em 0 0.5em;
  }

  .author-list { margin: 2rem auto; max-width: var(--measure); }
  .list-head { font-size: 1.4rem; margin: 1rem 0 0.25rem; text-align: center; }
  .list-meta {
    text-align: center; font-style: italic;
    color: var(--ink-muted); margin: 0 0 1.5rem; font-size: 0.95rem;
  }

  .ave-section { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--rule); }

  .contrib-list { list-style: none; padding: 0; counter-reset: contrib; }
  .contrib-list > li {
    counter-increment: contrib;
    padding: 1rem 0 1rem 2.5rem;
    border-bottom: 1px solid var(--rule);
    position: relative;
  }
  .contrib-list > li::before {
    content: counter(contrib);
    position: absolute; left: 0; top: 1rem;
    color: var(--ink-muted); font-style: italic;
    font-size: 0.85rem;
  }
  .contrib-list > li:last-child { border-bottom: 0; }

  .contrib-title { margin: 0; font-size: 1.1rem; }
  .contrib-meta { margin: 0.2rem 0 0; font-size: 0.88rem; color: var(--ink-soft); }
  .contrib-cahier { border: none; color: var(--ink-soft); }
  .contrib-cahier:hover .contrib-label,
  .contrib-cahier:hover .contrib-cahier-title { color: var(--rouge); }
  .contrib-label {
    color: var(--rouge); font-variant: small-caps; letter-spacing: 0.08em;
  }
  .contrib-cahier-title { font-style: italic; }
  .contrib-date { color: var(--ink-muted); }
  .contrib-introduces {
    margin: 0.2rem 0 0; font-size: 0.88rem; color: var(--ink-muted); font-style: italic;
    border-left: 2px solid var(--rouge); padding-left: 0.75rem;
  }
  .contrib-read { margin: 0.3rem 0 0; font-size: 0.85rem; }
  .sep { color: var(--ink-muted); }
  .empty { text-align: center; color: var(--ink-muted); font-style: italic; }
</style>
